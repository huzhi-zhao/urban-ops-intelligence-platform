ENV=PRO

# ── Object storage (MinIO on the storage node) ────────────────────────────────
# Bronze / Silver / Gold all live here.
# See docs/dev/adr/0006-storage-compute-query-stack.md.
#
# S3_ENDPOINT_URL must be the MinIO API port (9000), not the console port (9001).
# Requests are always path-style — MinIO has no virtual-host DNS.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=uoip
# MinIO ignores the region, but SigV4 signing requires *some* value.
S3_REGION=us-east-1

# ── Airflow (compute node) ────────────────────────────────────────────────────
# All four are REQUIRED — infra/docker/docker-compose.yml uses ${VAR:?} and
# refuses to start without them rather than falling back to a weak default.
#
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_WEBSERVER_SECRET_KEY=
AIRFLOW_JWT_SECRET=

# ── Upstream APIs ─────────────────────────────────────────────────────────────
# Socrata App Token（公开数据，本项目不需要 Secret Token）
SOCRATA_APP_TOKEN=

# ── Snapshot collection (BO-7, storage node cron) ─────────────────────────────
# 两者都可选，未设置只会 WARN 不会中断采集 —— 丢一条告警，好过因为告警没配好
# 而丢一天不可再生的历史。
#
# 失败通知：进程还活着时自己 POST。
SNAPSHOT_ALERT_WEBHOOK_URL=
# 死人开关：成功后 GET 打卡，由外部服务（healthchecks.io 一类）在**没等到**打卡
# 时反向告警。这条覆盖的是「进程根本没跑」——此时没有任何进程能发通知。
SNAPSHOT_WATCHDOG_URL=

# ── Backfill plan scripts (scripts/backfill/plan_*.sh) ────────────────────────
# 长回填（几小时、nohup 里跑）的失败/中断通知。留空则回落到上面的
# SNAPSHOT_ALERT_WEBHOOK_URL —— 同一个 Discord 频道，共用没问题。
BACKFILL_ALERT_WEBHOOK_URL=
# 回填专用的死人开关（healthchecks.io 一类）：开始 /start、成功打卡、失败 /fail。
# **不要**填 SNAPSHOT_WATCHDOG_URL 的地址：那条检查是 BO-7 每日快照采集的，
# 从回填这边打卡会在快照根本没跑的那天替它签到，正好压掉它该报的警。
# 留空只是没有「机器中途消失」这一层覆盖，失败通知照常。
BACKFILL_WATCHDOG_URL=
