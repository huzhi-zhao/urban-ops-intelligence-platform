ENV=PRO

# ── Object storage (MinIO on the storage node) ────────────────────────────────
# Bronze / Silver / Gold all live here.
# See docs/dev/adr/0006-storage-compute-query-stack.md.
#
# S3_ENDPOINT_URL must be the MinIO API port (9000), not the console port (9001).
# Requests are always path-style — MinIO has no virtual-host DNS.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=uoip
# MinIO ignores the region, but SigV4 signing requires *some* value.
S3_REGION=us-east-1

# ── Airflow (compute node) ────────────────────────────────────────────────────
# All four are REQUIRED — infra/docker/docker-compose.yml uses ${VAR:?} and
# refuses to start without them rather than falling back to a weak default.
#
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_WEBSERVER_SECRET_KEY=
AIRFLOW_JWT_SECRET=

# Airflow 的对外地址。跑在 nginx https 反代后面时必须正确，否则静态资源和
# 登录后的重定向会指向 http://localhost:28080。留空则用 compose 里的默认值
# https://airflow.huzhi.dev；纯本地开发填 http://localhost:28080。
AIRFLOW_BASE_URL=

# ── Upstream APIs ─────────────────────────────────────────────────────────────
# Socrata App Token (public data; this project does not need a Secret Token)
SOCRATA_APP_TOKEN=

# ── Snapshot collection (BO-7, storage node cron) ─────────────────────────────
# Both are optional; if unset they only WARN and never abort collection — better
# to lose one alert than to lose a day of non-reproducible history because
# alerting was misconfigured.
#
# Failure notification: the process POSTs this itself while still alive.
SNAPSHOT_ALERT_WEBHOOK_URL=
# Dead man's switch: GET-ping on success; an external service (e.g. healthchecks.io)
# alerts when it does NOT see a ping in time. This covers the case where the
# process never ran at all — no process is left to send any notification.
SNAPSHOT_WATCHDOG_URL=

# ── Backfill plan scripts (scripts/backfill/plan_*.sh) ────────────────────────
# Failure/interruption notifications for long backfills (hours long, run under
# nohup). Leave blank to fall back to SNAPSHOT_ALERT_WEBHOOK_URL above — sharing
# the same Discord channel is fine.
BACKFILL_ALERT_WEBHOOK_URL=
# Backfill-specific dead man's switch (e.g. healthchecks.io): /start on begin,
# ping on success, /fail on failure. Do **not** reuse the SNAPSHOT_WATCHDOG_URL
# address here: that check belongs to BO-7's daily snapshot collection, and a
# ping from the backfill side would check in for it on a day the snapshot never
# ran — exactly suppressing the alert it exists to raise.
# Leaving this blank only drops the "host disappeared mid-run" coverage;
# failure notifications still work as normal.
BACKFILL_WATCHDOG_URL=
