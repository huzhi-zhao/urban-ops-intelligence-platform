# Airflow image extended with a JVM + Spark client so SparkSubmitOperator
# can submit jobs to the standalone Spark cluster (spark-master:7077) already
# running on this host, in the same `bigdata-net` Docker network.
#
# pyspark==3.5.1 must match the Spark cluster's version (apache/spark:3.5.1)
# — mismatched client/cluster versions fail at the protocol level, not with
# a clear error message.

FROM apache/airflow:3.2.2-python3.11

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    # openjdk-17-jre-headless doesn't create the /usr/lib/jvm/default-java
    # symlink (that's only provided by the default-jre/default-jdk meta
    # packages) — compute the real install path from `java` on PATH and
    # symlink it ourselves so JAVA_HOME below is stable across architectures
    # (arm64 vs amd64 ship different directory names under /usr/lib/jvm/).
    && ln -sfT "$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")" /usr/lib/jvm/default-java
USER airflow

# Empty on purpose. AIRFLOW__CORE__PLUGINS_FOLDER points here so that
# plugins_manager has nothing to scan: /opt/airflow/plugins is a PYTHONPATH
# root in this deployment, not a plugins directory. Full reasoning in
# docker-compose.yml next to AIRFLOW__CORE__PLUGINS_FOLDER.
RUN mkdir -p /opt/airflow/no-plugins

RUN pip install --no-cache-dir \
    pydantic>=2.0 \
    pyyaml \
    requests \
    python-dotenv \
    google-cloud-storage \
    apache-airflow-providers-fab \
    apache-airflow-providers-apache-spark \
    apache-airflow-providers-snowflake \
    pandas \
    pyspark==3.5.1 \
    trino>=0.330.0

ENV JAVA_HOME=/usr/lib/jvm/default-java
ENV SPARK_HOME=/home/airflow/.local/lib/python3.11/site-packages/pyspark
ENV PATH="${SPARK_HOME}/bin:${PATH}"
